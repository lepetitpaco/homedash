{
  "name": "homedash",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 7778",
    "server:dev": "node --watch server/main.ts",
    "server:build": "tsc -p server",
    "build": "vite build && tsc -p server",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit && tsc -p tests-ts --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 7778"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@types/node": "^24.0.0",
    "vitest": "^3.2.0"
  }
}
